load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "test-test_allocator-leak",
    size = "small",
    srcs = ["test-test_allocator-leak.cpp"],
    # This test deliberately leaks, which AddressSanitizer would report.
    tags = ["noasan"],
    deps = [
        "//:utility",
        "@boost.test//:unit_test_main",
    ],
)

cc_test(
    name = "test-tracked",
    size = "small",
    srcs = ["test-tracked.cpp"],
    # The test destructs an object twice on purpose. With optimisation, GCC
    # assumes the object's memory is dead after the first destructor and may
    # remove stores to it, so tracked<> could not detect the second destruction.
    copts = select({
        "@rules_cc//cc/compiler:gcc": ["-fno-lifetime-dse"],
        "//conditions:default": [],
    }),
    deps = [
        "//:utility",
        "@boost.test//:unit_test_main",
    ],
)
