UseColor: true

Checks: >
    -*,
    misc-include-cleaner,

# These are checks that it might be worth switching on:

# abseil-*,
# boost-*,
# bugprone-*,
# cert-*,
# clang-analyzer-*,
# concurrency-*,
# cppcoreguidelines-*,
# google-*,
# hicpp-*,
# linuxkernel-*,
# llvm-*,
# misc-*,
# modernize-*,
# mpi-*,
# performance-*,
# portability-*,
# readability-*,
# -modernize-use-trailing-return-type,
# -llvm-header-guard,

CheckOptions:
    # Mark some external headers as non-public, so misc-include-cleaner does
    # not suggest internal headers or forward declarations.
    misc-include-cleaner.IgnoreHeaders: "boost/test/.*;boost/mpl/(bool|char|int|integral_c|long|size_t|void)(_fwd)?\\.hpp;boost/(.*/)?(detail|aux_)/.*"

WarningsAsErrors: "*"
