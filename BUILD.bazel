load("@rules_cc//cc:defs.bzl", "cc_library")

# The main target that should be used by other modules that want to depend on
# this library.
cc_library(
    name = "utility",
    # Headers that a user of this library can include.
    hdrs = glob([
        "include/utility/*.hpp",
        "include/utility/test/*.hpp",
    ]),
    # Allow each header to be compiled on its own, to check that it includes
    # everything it needs, by passing Bazel --process_headers_in_dependencies.
    features = ["parse_headers"],
    # The prefix to be added to the include path.
    # If the include directory can be set to "include", then include_prefix
    # should be set to "".
    include_prefix = "",
    # The prefix to be stripped from the include path.
    strip_include_prefix = "include/",
    visibility = ["//visibility:public"],
    # Dependencies of this library.
    deps = [
        "@meta",
    ],
)

# The host platform, marked as having clang-cl.
# Bazel selects rules_cc's clang-cl toolchain on Windows only for an execution
# platform with this constraint; see --config=clang-cl in .bazelrc.
platform(
    name = "windows_clang_cl",
    constraint_values = ["@rules_cc//cc/private/toolchain:clang-cl"],
    parents = ["@platforms//host"],
)
